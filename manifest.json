{
  "manifest_version": 3,
  "name": "浮光画布（LumaCanvas）",
  "version": "1.0.0",
  "description": "自定义网页点击特效、滑动轨迹特效与动态背景。",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "浮光画布（LumaCanvas）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["fx.js", "bg.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  }
}
